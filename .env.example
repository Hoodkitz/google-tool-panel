# ─────────────────────────────────────────────
# google-tool-panel — environment variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Database (Prisma) ─────────────────────────
# SQLite example: file:./dev.db
DATABASE_URL=

# ── Next.js public vars (exposed to the browser) ─
# Base URL of the API (e.g. http://localhost:3000)
NEXT_PUBLIC_API_URL=

# ── Server port ───────────────────────────────
PORT=

# ── NextAuth ──────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL=
# openssl rand -base64 32
NEXTAUTH_SECRET=

# ── OpenRouter ────────────────────────────────
OPENROUTER_API_KEY=

# ── Android keystore (Capacitor / Tauri builds) ─
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEYSTORE_ALIAS=
ANDROID_KEYSTORE_ALIAS_PASSWORD=
